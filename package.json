{
  "name": "dsh-docker-sandbox",
  "version": "0.3.0",
  "description": "Per-chat Docker container sandbox for DeepSeek Harness: every shell command, file operation, and terminal session runs inside a dedicated container on the local Docker engine, and the session header shows which container the chat is running in.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./host-restore": {
      "default": "./lib/host-restore.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "agent",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "sandbox",
    "docker",
    "container",
    "windows"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-modules"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-fs": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-shell": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-terminal": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config test/vitest.integration.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  }
}
