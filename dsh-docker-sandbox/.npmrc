# The DSH seam packages are provided by the app runtime, not by npm: their
# published versions predate the installed runtime, so peer dependencies must
# not be resolved or installed here. Types for them come from
# `src/types/seams.d.ts`. `legacy-peer-deps` is npm's equivalent of pnpm's
# `auto-install-peers=false`: it keeps npm from pulling peer trees the runtime
# already provides.
legacy-peer-deps=true
